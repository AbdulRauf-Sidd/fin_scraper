ld--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/LoFi_InfoFinanciere_Banner_Communique_01.jpg?itok=_skBszyC\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/sale-contract-body-shop-signed-between-loreal-and-natura\" data-once=\"datalayer\"><span>Sale contract of The Body Shop signed between L'Or\u00e9al and Natura</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/sale-contract-body-shop-signed-between-loreal-and-natura\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2017-06-27T06:30:00Z\">27 June 2017</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 27 June 2017&nbsp; \u02d7 &nbsp;L'Or\u00e9al announces that the contract for the sale of The Body Shop to Natura was signed after receiving the advice of L'Or\u00e9al's Works Council1 regarding this project announced on 9 June.</div>\n      \n      </div>\n    </div>\n  </div>\n</div>\n</div><div class=\"views-row\">\n<div class=\"nodetype--publication news-events-listing__item\">\n  <div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-and-natura-enter-exclusive-discussions-regarding-body-shop\" aria-label=\"L&amp;#039;Or\u00e9al and Natura enter into exclusive discussions regarding The Body Shop\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/2020-10/Logo_9.jpg?itok=CmolWVzx\" width=\"150\" height=\"150\" alt=\"\" title=\"Logo L'Or\u00e9al circle\" typeof=\"foaf:Image\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-and-natura-enter-exclusive-discussions-regarding-body-shop\" data-once=\"datalayer\"><span>L'Or\u00e9al and Natura enter into exclusive discussions regarding The Body Shop</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-and-natura-enter-exclusive-discussions-regarding-body-shop\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2017-06-09T06:30:00Z\">09 June 2017</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy \u2013 9 June 2017 \u2013 Following an extensive review of the strategic options for The Body Shop to ensure its best future development, L\u2019Or\u00e9al has received a firm offer from Natura Cosm\u00e9ticos SA to acquire The Body Shop and has entered 