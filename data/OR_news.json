 class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-signs-agreement-acquire-skinbetter-science-physician-dispensed-american\" aria-label=\"L\u2019Or\u00e9al signs an agreement to acquire Skinbetter Science, a physician-dispensed American skincare brand\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/2022-09/SkinbetterScience.jpg?h=7b2436f4&amp;itok=QRxXod_c\" width=\"150\" height=\"150\" alt=\"\" title=\"Skinbetter Science\" typeof=\"foaf:Image\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-very-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-signs-agreement-acquire-skinbetter-science-physician-dispensed-american\" data-once=\"datalayer\"><span>L\u2019Or\u00e9al signs an agreement to acquire Skinbetter Science, a physician-dispensed American skincare brand </span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-signs-agreement-acquire-skinbetter-science-physician-dispensed-american\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2022-09-23T06:00:00Z\">23 September 2022</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"pastefromword field body field--type-tex