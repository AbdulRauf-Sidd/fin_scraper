    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/annual-general-meeting-18-april-2019-2018-registration-document\" aria-label=\"Annual General Meeting of 18 April 2019 / 2018 Registration Document\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/egerie_863-533.png?itok=Grr2_ct6\" width=\"150\" height=\"150\" alt=\"\" title=\"L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Annual General Meeting\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/annual-general-meeting-18-april-2019-2018-registration-document\" data-once=\"datalayer\"><span>Annual General Meeting of 18 April 2019 / 2018 Registration Document</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/annual-general-meeting-18-april-2019-2018-registration-document\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2019-03-14T15:00:00Z\">14 March 2019</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Information available concerning the Annual General Meeting to be held on Thursday 18 April 2019 and the 2018 Registration Document.\nANNUAL GENERAL MEETING SET FOR THURSDAY 18 APRIL 2019:</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/2018-annual-results\" aria-label=\"2018 Annual Results\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/LoFi_InfoFinanciere_Banner_Communique_01.jpg?itok=_skBszyC\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Results\n        </div>\n            <div class=\"news-events-listing__title\">\n        <a href=\"/eng/news-release/2018-annual-results\" data-once=\"datalayer\"><span>2018 Annual Results</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/2018-annual-results\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2019-02-07T17:30:00Z\">07 February 2019</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Best sales growth in more than 10 years: +7.1%1\nNew record for operating margin: 18.3%\n[Video] Watch the replay of the Financial Information Meeting.\nAll presentations are available for download here.\n\nSales: 26.9 billion euros\n\n+7.1% like-for-like1\n+8.0% at constant exchange rates\n+3.5% based on reported figures\n\n</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-creates-corporate-venture-capital-fund-dedicated-accompanying-innovative\" aria-label=\"L&amp;#039;Or\u00e9al creates a corporate venture capital fund dedicated to accompanying innovative startups\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/sillages_863x533.jpg?itok=4lt-8zpF\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Other financial information\n        </div>\n            <div class=\"title-very-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-creates-corporate-venture-capital-fund-dedicated-accompanying-innovative\" data-once=\"datalayer\"><span>L'Or\u00e9al creates a corporate venture capital fund dedicated to accompanying innovative startups</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-creates-corporate-venture-capital-fund-dedicated-accompanying-innovative\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-12-05T17:00:00Z\">05 December 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 5 December 2018 - L'Or\u00e9al&nbsp;announces the launch of&nbsp;BOLD Business Opportunities for L'Or\u00e9al Development, a corporate venture capital fund that will take minority stakes in innovative startups with high growth potential.</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/important-appointments-within-loreals-executive-committee\" aria-label=\"Important appointments within L&amp;#039;Or\u00e9al&amp;#039;s Executive Committee\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/2020-10/Logo_3.jpg?itok=rWT0YTm5\" width=\"150\" height=\"150\" alt=\"\" title=\"L'Or\u00e9al logo circle\" typeof=\"foaf:Image\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Governance\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/important-appointments-within-loreals-executive-committee\" data-once=\"datalayer\"><span>Important appointments within L'Or\u00e9al's Executive Committee</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/important-appointments-within-loreals-executive-committee\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-11-19T17:00:00Z\">19 November 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 19 November 2018 - L'Or\u00e9al announces important appointments within the Group's Executive Committee.\n\n Appointment of Christophe Babule as Executive Vice-President, Chief Financial Officer\n</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/sales-30-september-2018\" aria-label=\"Sales at 30 September 2018\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/LoFi_InfoFinanciere_Banner_Communique_01.jpg?itok=_skBszyC\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Sales\n        </div>\n            <div class=\"news-events-listing__title\">\n        <a href=\"/eng/news-release/sales-30-september-2018\" data-once=\"datalayer\"><span>Sales at 30 September 2018</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/sales-30-september-2018\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-10-30T17:00:00Z\">30 October 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Strong growth: +6.8% over the first nine months&nbsp;1\n\nSales: 19.86 billion euros\n\n+6.8% like-for-like &nbsp;1\n+7.4% at constant exchange rates\n+1.8% based on reported figures\n\nStrong growth at L'Or\u00e9al Luxe and Active Cosmetics\nPerformance remains contrasted by Division and by geographic Zone\nReduced impact of exchange rate effects\n\n&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-finalizes-acquisition-logocos-naturkosmetik-ag-0\" aria-label=\"L\u2019Or\u00e9al finalizes the acquisition of Logocos Naturkosmetik AG\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/Logocos_863x533-min.jpg?itok=VNguAD2J\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-finalizes-acquisition-logocos-naturkosmetik-ag-0\" data-once=\"datalayer\"><span>L\u2019Or\u00e9al finalizes the acquisition of Logocos Naturkosmetik AG</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-finalizes-acquisition-logocos-naturkosmetik-ag-0\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-10-17T06:30:00Z\">17 October 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 17 October 2018 - After obtaining the necessary authorizations from the relevant authorities, L\u2019Or\u00e9al has finalized the acquisition of German natural beauty company Logocos Naturkosmetik AG, in accordance with the terms announced on 1 August 2018.\nAbout L'Or\u00e9al&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-announces-project-acquisition-societe-thermes-roche-posay\" aria-label=\"L&amp;#039;Or\u00e9al announces the project of acquisition of Soci\u00e9t\u00e9  des Thermes de La Roche-Posay\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/LRP_863x533-min.jpg?itok=xLhF-kXi\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-very-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-announces-project-acquisition-societe-thermes-roche-posay\" data-once=\"datalayer\"><span>L'Or\u00e9al announces the project of acquisition of Soci\u00e9t\u00e9  des Thermes de La Roche-Posay</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-announces-project-acquisition-societe-thermes-roche-posay\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-08-01T06:45:00Z\">01 August 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 1 August 2018 - L'Or\u00e9al has submitted to the shareholders of Holding STRP (Soci\u00e9t\u00e9 des Thermes de La Roche-Posay) an irrevocable offer for the acquisition of the totality of the shares of the company.</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-acquires-german-natural-beauty-company-logocos-naturkosmetik-ag\" aria-label=\"L&amp;#039;Or\u00e9al acquires German natural beauty company Logocos Naturkosmetik AG\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/Logocos_863x533-min.jpg?itok=VNguAD2J\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-acquires-german-natural-beauty-company-logocos-naturkosmetik-ag\" data-once=\"datalayer\"><span>L'Or\u00e9al acquires German natural beauty company Logocos Naturkosmetik AG</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-acquires-german-natural-beauty-company-logocos-naturkosmetik-ag\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-08-01T06:30:00Z\">01 August 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 1 August 2018 - L'Or\u00e9al announces the signing of an agreement to acquire Logocos Naturkosmetik AG, the German beauty company which pioneered natural cosmetics with the brand Logona and other brands such as Sante.</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/first-half-2018-results\" aria-label=\"First-half 2018 results\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/LoFi_InfoFinanciere_Banner_Communique_01.jpg?itok=_skBszyC\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Results\n        </div>\n            <div class=\"news-events-listing__title\">\n        <a href=\"/eng/news-release/first-half-2018-results\" data-once=\"datalayer\"><span>First-half 2018 results</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/first-half-2018-results\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-07-26T16:30:00Z\">26 July 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Strong pace of growth continues: +6.6% 1\ncombined with quality results\n&nbsp;\n\n\nSales: 13.39 billion euros\n\n\n+6.6% like-for-like 1\n+7.0% at constant exchange rates\n-0.2% based on reported figures\n\n\nDouble-digit growth at L\u2019Or\u00e9al Luxe and Active Cosmetics\nVery strong growth of the New Markets and gradual improvement of North America</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-finalizes-acquisition-korean-stylenanda\" aria-label=\"L&amp;#039;Or\u00e9al finalizes the acquisition of Korean Stylenanda\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/Nanda_863x533.jpg?itok=aQteMll4\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-finalizes-acquisition-korean-stylenanda\" data-once=\"datalayer\"><span>L'Or\u00e9al finalizes the acquisition of Korean Stylenanda</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-finalizes-acquisition-korean-stylenanda\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-06-20T11:14:47Z\">20 June 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 20 June 2018 - After obtaining the necessary authorizations from the relevant authorities, L'Or\u00e9al has finalized the acquisition of the Korean lifestyle company Nanda Co. Ltd, in accordance with the terms announced on 2 May 2018.\n\n&nbsp;About L'Or\u00e9al&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-and-valentino-announce-worldwide-license-agreement-fine-fragrances-and-luxury\" aria-label=\"L&amp;#039;Or\u00e9al and Valentino announce a worldwide license agreement for fine fragrances and luxury beauty\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/Valentino_863x533-min.jpg?itok=OaRRtJPQ\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-very-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-and-valentino-announce-worldwide-license-agreement-fine-fragrances-and-luxury\" data-once=\"datalayer\"><span>L'Or\u00e9al and Valentino announce a worldwide license agreement for fine fragrances and luxury beauty</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-and-valentino-announce-worldwide-license-agreement-fine-fragrances-and-luxury\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-05-28T06:30:00Z\">28 May 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 28 May 2018 - L'Or\u00e9al and Valentino announce the signature of a worldwide long-term license agreement for the creation, development and distribution of fine fragrances and luxury beauty under the Valentino brand.&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-acquires-pulp-riot-new-us-based-professional-haircolor-brand\" aria-label=\"L&amp;#039;Or\u00e9al acquires Pulp Riot, the new US based professional haircolor brand\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/Pulp_Riot_863x533.jpg?itok=FB4edCSU\" width=\"150\" height=\"150\" title=\"Pulp Riot\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-acquires-pulp-riot-new-us-based-professional-haircolor-brand\" data-once=\"datalayer\"><span>L'Or\u00e9al acquires Pulp Riot, the new US based professional haircolor brand</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-acquires-pulp-riot-new-us-based-professional-haircolor-brand\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-05-25T06:30:00Z\">25 May 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 25 May 2018 - L'Or\u00e9al has finalized the acquisition of Pulp Riot, a professional haircolor brand launched by David and Alexis Thurston in the United States in June, 2016.&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/launch-employee-share-ownership-plan\" aria-label=\"Launch of an Employee Share Ownership Plan\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/2020-10/Logo_4.jpg?itok=WCNzuLhn\" width=\"150\" height=\"150\" alt=\"\" title=\"L'Or\u00e9al logo circle\" typeof=\"foaf:Image\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Other financial information\n        </div>\n            <div class=\"news-events-listing__title\">\n        <a href=\"/eng/news-release/launch-employee-share-ownership-plan\" data-once=\"datalayer\"><span>Launch of an Employee Share Ownership Plan</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/launch-employee-share-ownership-plan\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-05-15T06:30:18Z\">15 May 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 15 May 2018 - L'Or\u00e9al is announcing the launch of its first Employee Share Ownership Plan.\n&nbsp;\nThe plan will be rolled out in 52 countries and will give L'Or\u00e9al employees, in France and internationally, the possibility to be even more closely linked to the Group's development.\n&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-acquires-korean-stylenanda\" aria-label=\"L&amp;#039;Or\u00e9al acquires Korean Stylenanda\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/Nanda_863x533.jpg?itok=aQteMll4\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-acquires-korean-stylenanda\" data-once=\"datalayer\"><span>L'Or\u00e9al acquires Korean Stylenanda</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-acquires-korean-stylenanda\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-05-02T16:00:00Z\">02 May 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, 2 May 2018&nbsp;-&nbsp;L'Or\u00e9al announces the acquisition of 100% of Nanda Co. Ltd., the Korean lifestyle make-up and fashion company founded by Kim So-Hee in Seoul in 2004.&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/annual-general-meeting-and-board-directors-meeting-17-april-2018\" aria-label=\"Annual General Meeting and Board of Directors\u2019 Meeting of 17 April 2018\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/AGM_2018_paysage.jpg?itok=uBoy4Xj5\" width=\"150\" height=\"150\" alt=\"\" title=\"L'Or\u00e9al Annual General Meeting\" typeof=\"foaf:Image\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Annual General Meeting\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/annual-general-meeting-and-board-directors-meeting-17-april-2018\" data-once=\"datalayer\"><span>Annual General Meeting and Board of Directors\u2019 Meeting of 17 April 2018</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/annual-general-meeting-and-board-directors-meeting-17-april-2018\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-04-17T16:00:14Z\">17 April 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">\nAppointment as Director of Mr Patrice Caine and Mr Axel Dumas\nRenewal of the tenure as Director of Mr Jean-Paul Agon and Mrs Bel\u00e9n Garijo\nApproval of a dividend of \u20ac3.55 per share up by +7.6%\nShare buyback programme of \u20ac500 million\n\n&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/first-quarter-2018-sales\" aria-label=\"First quarter 2018 sales\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/LoFi_InfoFinanciere_Banner_Communique_01.jpg?itok=_skBszyC\" width=\"150\" height=\"150\" title=\" L'Or\u00e9al Finance - Beauty, a value for the future\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Sales\n        </div>\n            <div class=\"news-events-listing__title\">\n        <a href=\"/eng/news-release/first-quarter-2018-sales\" data-once=\"datalayer\"><span>First quarter 2018 sales</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/first-quarter-2018-sales\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-04-12T16:00:00Z\">12 April 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Strong sales growth: +6.8% 1\n\nSales: 6.78 billion euros\n\n&nbsp;\n&nbsp; &nbsp; &nbsp;+6.8% like-for-like 1\n&nbsp; &nbsp; &nbsp;-1.0% based on reported figures 2\n\nAcceleration at L'Or\u00e9al Luxe and Active Cosmetics\nNew Markets grew by +14.9% 1, driven by Asia Pacific\nSharp contrasts between Divisions and geographic Zones\n\n&nbsp;</div>\n      \n      </div>\n    </div>\n  </div>",
    "<div class=\"row\">\n    <div class=\"col-12 col-lg-3 offset-lg-1 col-xl-2 offset-xl-2 news-events-listing__image-wrapper\">\n      <div class=\"news-events-listing__image\">\n        <a href=\"/eng/news-release/loreal-and-armani-renew-their-partnership-beauty\" aria-label=\"L&amp;#039;Or\u00e9al and Armani renew their partnership in beauty\">\n                      <article role=\"presentation\">\n  \n      \n            <div class=\"field image field--type-image field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/thumbnail_150_150/public/publication-content/images/Giorgio_Armani_850_525.jpg?itok=cQU4w75R\" width=\"150\" height=\"150\" title=\"Giorgio Armani Beaut\u00e9 boutique\" typeof=\"foaf:Image\" alt=\"\">\n\n\n</div>\n      \n  </article>\n\n                  </a>\n      </div>\n    </div>\n    <div class=\"col-12 col-md-10 offset-md-1 col-lg-7 col-xl-6 offset-lg-0 offset-xl-0 news-events-listing__info-wrapper\">\n              <div class=\"news-events-listing__topic\">\n          Acquisitions\n        </div>\n            <div class=\"title-small news-events-listing__title\">\n        <a href=\"/eng/news-release/loreal-and-armani-renew-their-partnership-beauty\" data-once=\"datalayer\"><span>L'Or\u00e9al and Armani renew their partnership in beauty</span>\n</a>\n      </div>\n      <div class=\"news-events-listing__info\">\n        <div class=\"news-events-listing__type\">\n          <a href=\"/eng/news-release/loreal-and-armani-renew-their-partnership-beauty\">News release</a>\n        </div>\n        <div class=\"news-events-listing__date\">\n          <time datetime=\"2018-03-22T07:30:00Z\">22 March 2018</time>\n\n        </div>\n      </div>\n      <div class=\"news-events-listing__body\">\n        \n            <div class=\"field body field--type-text-with-summary field__item\">Clichy, Milan - Thursday 22 March 2018\nL'Or\u00e9al and Armani announce today the signature of an agreement to renew their license until 2050.</div>\n  